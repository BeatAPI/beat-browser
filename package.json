{
  "name": "@beatapi/beat-browser",
  "version": "1.2.0",
  "description": "BeatBrowser — MCP + Chrome extension for signed-in Chrome control (BeatAPI).",
  "type": "module",
  "bin": {
    "beat-browser": "src/cli.js"
  },
  "files": [
    "src",
    "extension",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
